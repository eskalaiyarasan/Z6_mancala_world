{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "board.schema.json",
  "title": "Board Schema",

  "$defs": {
    "Board": {
      "type": "object",
      "required": ["Nsides","Nseeds","Npits","Pits","Nround"],
      "properties": {
        "Active":{
          "type":"boolean", "default":true
        },
        "Turn":{
          "type":"integer","default":0
        },
        "Nsides": {
          "type": "integer",
          "minimum": 2, "maximum": 5, "default":2
        },
        "Nseeds": {
          "type": "integer",
          "minimum": 4, "maximum": 15, "default":4
        },
        "Npits": {
          "type": "integer",
          "minimum": 5, "maximum": 15, "default":7
        },
        "Pits":{
          "type":"array",
          "items": {
            "$ref": "pit.schema.json#/$defs/Pit"
          }
        },
        "Nround": {
          "type": "integer",
          "minimum": 1,  "default":1
        },
        "Visibility":{
          "type":"string","default":"TRANSPARENT",
          "enum": ["TRANSPARENT","TRANSLUCENT","OPAQUE"]
        },
        "History":{
          "type":"array",
          "items": {
            "$ref": "history.schema.json#/$defs/MoveHistory"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
