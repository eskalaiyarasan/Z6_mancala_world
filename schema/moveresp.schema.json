{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moveresp.schema.json",
  "title": "move response Schema",

  "$defs": {
    "BoardResp": {
      "type": "object",
      "required": ["schema_version", "GameID", "Type", "Sequence"],
      "properties": {
        "schema_version": {
              "type": "integer",
              "default": 1
            },
        "Active":{
          "type":"boolean", "default":true
        },
        "GameID": {
          "type": "string",
          "format": "uuid"
        },
        "Turn":{
          "type":"integer"
        },
        "Type":{
          "type":"string",
          "enum": ["ERROR", "OK","RESULT"]
        },
        "Nround": {
          "type": "integer",
          "minimum": 1,  "default":1
        },
        "Sequence": {
          "type": "integer",
          "minimum": 0,
          "description": "The move number (0, 1, 2...)"
        },
        "Visibility":{
          "type":"string","default":"TRANSPARENT",
          "enum": ["TRANSPARENT","TRANSLUCENT","OPAQUE"]
        },
        "History":{
          "type":"array",
          "items": {
            "$ref": "move.schema.json#/$defs/Move"
          }
        },
        "Details": {
          "type": "array",
          "items": {
            "$ref": "movedetail.schema.json#/$defs/Detail"
          }
        },
        "Result":{
          "$ref": "result.schema.json/$defs/Result"
        },
        "Error":{
          "$ref": "error.schema.json/$defs/Result"
        }
      },
      "additionalProperties": false
    }
  }
}
