{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pit.schema.json",
  "title": "Pit Schema",

  "$defs": {
    "Pit": {
      "type": "object",
      "required": ["Type","Index","Value"],
      "properties": {
        "Type": {
          "type":"string",
          "enum":["NORMAL", "STORE","KINGS"],
          "default": "NORMAL"
        },
        "Index": {
          "type":"integer",
          "maximum": 100,
          "minimum": 1,
          "default":100
        },
        "Owner": {
          "type":"integer",
          "maximum": 10,
          "minimum": 1,
          "default":10
        },
        "Side":{
          "type":"integer"
        },
        "Share":{
          "type":"array",
          "items": {
              "type": "integer"
            }
        },
        "Value": {
          "type":"integer",
          "maximum": 100,
          "minimum": 1,
          "default":100
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "Type": { "const": "STORE" } }
          },
          "then": {
            "required": ["Type", "Index", "Value", "Owner"]
          }
        },
        {
          "if": {
            "properties": { "Type": { "const": "KINGS" } }
          },
          "then": {
            "required": ["Type", "Index", "Value", "Share"]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
