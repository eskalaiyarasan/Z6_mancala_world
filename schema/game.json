{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game.schema.json",
  "title": "Game Schema",

  "$defs": {
    "Game": {
      "type": "object",
      "required": ["NAME", "LEVEL"],
      "properties": {
        "Name": {
          "type":"string",
          "enum":["INDIAN_CLASSIC_SURYA ", "INDIAN_CLASSIC_DHARMA",
            "INDIAN_KINGS_SURYA", "INDIAN_KINGS_DHARMA"],
          "default": "INDIAN_CLASSIC_SURYA"
        },
        "Level": {
          "type":"integer",
          "maximum": 10,
          "minimum": 1,
          "default":1
        },
        "Players": {
          "type": "array",
          "items": {
            "type": "string",
            "minimum": 0
          }
        },
      },
      "additionalProperties": false
    }
  }
}
