{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game.schema.json",
  "title": "Root Schema",

  "$defs": {
    "Root": {
      "type": "object",
      "required": ["GameID","Game","Board"],
      "properties": {
        "GameID": {
          "type": "string",
          "format": "uuid"
        },
        "Game": {
          "$ref": "new_game_request.schema.json#/$defs/Game"
        },
        "Board": {
          "$ref": "board.schema.json#/$defs/Board"
        },
        "CreatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "Status": {
          "type": "string",
          "enum": ["toss", "active", "paused", "done"]
        },
        "Result": {
          "$ref": "result.schema.json/$defs/Result"
        }
      },
      "additionalProperties": false
    }
  }
}
